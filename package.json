{
  "name": "sentinel-fraud-detection",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first, event-driven TypeScript monorepo for real-time fraud detection",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.1"
  }
}
